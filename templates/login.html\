<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign in — LSPSO</title>
<meta name="theme-color" content="#f6f5f2">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Manrope:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
<main class="home">
  <div class="home-inner auth-inner">

    <a class="wordmark auth-mark" href="/">LSPSO<span class="dot">.</span></a>
    <h1 class="auth-title">Sign in or create an account</h1>
    <span class="label">One account, everywhere</span>

    {% with messages = get_flashed_messages() %}
      {% if messages %}
        {% for m in messages %}<div class="flash">{{ m }}</div>{% endfor %}
      {% endif %}
    {% endwith %}

    <div class="auth-card">

      {% if providers.google %}
      <a class="oauth" href="{{ url_for('auth.google_start') }}">
        <svg viewBox="0 0 18 18" width="17" height="17" aria-hidden="true">
          <path fill="#4285F4" d="M17.6 9.2c0-.6-.1-1.2-.2-1.8H9v3.5h4.8a4.1 4.1 0 01-1.8 2.7v2.2h2.9c1.7-1.6 2.7-3.9 2.7-6.6z"/>
          <path fill="#34A853" d="M9 18c2.4 0 4.5-.8 6-2.2l-2.9-2.2c-.8.5-1.8.9-3.1.9-2.4 0-4.4-1.6-5.1-3.8H.9v2.3A9 9 0 009 18z"/>
          <path fill="#FBBC05" d="M3.9 10.7a5.4 5.4 0 010-3.4V5H.9a9 9 0 000 8l3-2.3z"/>
          <path fill="#EA4335" d="M9 3.6c1.3 0 2.5.5 3.4 1.3l2.6-2.6A9 9 0 00.9 5l3 2.3C4.6 5.2 6.6 3.6 9 3.6z"/>
        </svg>
        Continue with Google
      </a>
      {% endif %}

      {% if providers.github %}
      <a class="oauth" href="{{ url_for('auth.github_start') }}">
        <svg viewBox="0 0 16 16" width="17" height="17" fill="#17181b" aria-hidden="true">
          <path d="M8 0C3.6 0 0 3.6 0 8a8 8 0 005.5 7.6c.4 0 .5-.2.5-.4v-1.4c-2.2.5-2.7-1-2.7-1-.4-1-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8 0 1.2.8 1.2.8.7 1.2 1.9.9 2.4.7 0-.6.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-4 0-.9.3-1.6.8-2.1 0-.2-.3-1 .1-2.1 0 0 .7-.2 2.2.8a7.6 7.6 0 014 0c1.5-1 2.2-.8 2.2-.8.4 1.1.2 1.9.1 2.1.5.5.8 1.2.8 2.1 0 3.1-1.9 3.8-3.6 4 .3.2.5.7.5 1.5v2.2c0 .2.2.5.6.4A8 8 0 0016 8c0-4.4-3.6-8-8-8z"/>
        </svg>
        Continue with GitHub
      </a>
      {% endif %}

      {% if providers.gitlab %}
      <a class="oauth" href="{{ url_for('auth.gitlab_start') }}">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <path fill="#E24329" d="M12 22.5l3.7-11.3H8.3z"/>
          <path fill="#FC6D26" d="M12 22.5L8.3 11.2H3.1z"/>
          <path fill="#FCA326" d="M3.1 11.2L2 14.7a.8.8 0 00.3.9L12 22.5z"/>
          <path fill="#E24329" d="M3.1 11.2h5.2L6.1 4.4c-.1-.4-.6-.4-.8 0z"/>
          <path fill="#FC6D26" d="M12 22.5l3.7-11.3h5.2z"/>
          <path fill="#FCA326" d="M20.9 11.2l1.1 3.5a.8.8 0 01-.3.9L12 22.5z"/>
          <path fill="#E24329" d="M20.9 11.2h-5.2l2.2-6.8c.2-.4.7-.4.8 0z"/>
        </svg>
        Continue with GitLab
      </a>
      {% endif %}

      {% if providers.microsoft %}
      <a class="oauth" href="{{ url_for('auth.microsoft_start') }}">
        <svg viewBox="0 0 23 23" width="16" height="16" aria-hidden="true">
          <path fill="#F25022" d="M1 1h10v10H1z"/>
          <path fill="#7FBA00" d="M12 1h10v10H12z"/>
          <path fill="#00A4EF" d="M1 12h10v10H1z"/>
          <path fill="#FFB900" d="M12 12h10v10H12z"/>
        </svg>
        Continue with Microsoft
      </a>
      {% endif %}

      {% if providers.chatgpt %}
      <a class="oauth" href="{{ url_for('auth.chatgpt_start') }}">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="#17181b" aria-hidden="true">
          <path d="M22.3 10a6 6 0 00-.5-4.9 6.1 6.1 0 00-6.5-2.9A6 6 0 0010.8 0a6.1 6.1 0 00-5.8 4.2A6 6 0 001 7.1a6.1 6.1 0 00.7 7.1 6 6 0 00.5 4.9 6.1 6.1 0 006.6 2.9A6 6 0 0013.2 24a6.1 6.1 0 005.8-4.2 6 6 0 004-2.9 6.1 6.1 0 00-.7-7zm-9.1 12.6a4.5 4.5 0 01-2.9-1l.1-.1 4.8-2.8a.8.8 0 00.4-.7v-6.8l2 1.2v5.6a4.5 4.5 0 01-4.4 4.6zM3.5 16.3a4.5 4.5 0 01-.5-3v.2l4.8 2.8a.8.8 0 00.8 0l5.9-3.4v2.3l-5 2.9a4.5 4.5 0 01-6-1.8zM2.3 7.9a4.5 4.5 0 012.4-2v5.7a.8.8 0 00.4.7l5.8 3.4-2 1.2-4.8-2.8a4.5 4.5 0 01-1.8-6.2zm16.6 3.9L13 8.4l2-1.1 4.8 2.8a4.5 4.5 0 01-.7 8.1v-5.7a.8.8 0 00-.4-.7zm2-3l-.1.1-4.8-2.8a.8.8 0 00-.8 0L9.3 9.5V7.2l5-2.9a4.5 4.5 0 016.6 4.5zM8.2 12.9l-2-1.2V6.1a4.5 4.5 0 017.4-3.5l-.1.1-4.8 2.8a.8.8 0 00-.4.7zm1.1-2.4L12 8.9l2.6 1.6v3l-2.6 1.5-2.6-1.5z"/>
        </svg>
        Continue with ChatGPT
      </a>
      {% endif %}

      {% if providers.discord %}
      <a class="oauth" href="{{ url_for('auth.discord_start') }}">
        <svg viewBox="0 0 24 18" width="18" height="18" fill="#5865F2" aria-hidden="true">
          <path d="M20.3 1.6A19.8 19.8 0 0015.4 0l-.3.5a18.3 18.3 0 00-6.2 0L8.6 0a19.7 19.7 0 00-5 1.6C.5 6.2-.3 10.8.1 15.3a19.9 19.9 0 006 3 14.6 14.6 0 001.3-2.1 13 13 0 01-2-1l.5-.4a14.2 14.2 0 0012.2 0l.5.4a13 13 0 01-2 1 14.4 14.4 0 001.3 2.1 19.8 19.8 0 006-3c.5-5.2-.8-9.8-3.6-13.7zM8 12.6c-1.2 0-2.2-1.1-2.2-2.4S6.8 7.7 8 7.7s2.2 1.1 2.2 2.5-1 2.4-2.2 2.4zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.5 2.2-2.5 2.2 1.1 2.2 2.5-1 2.4-2.2 2.4z"/>
        </svg>
        Continue with Discord
      </a>
      {% endif %}

      {% if providers.yahoo %}
      <a class="oauth" href="{{ url_for('auth.yahoo_start') }}">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="#6001D2" aria-hidden="true">
          <path d="M2 5.4h4.2l2.9 7.4 2.9-7.4h4.1L10.9 21H6.7l2-4.6zM17.3 12.6h3.5L20 16h-3.5zM18.3 5.4h4L18.9 11h-3.2z"/>
        </svg>
        Continue with Yahoo
      </a>
      {% endif %}

      {% if (providers.google or providers.github or providers.gitlab or providers.microsoft or providers.discord or providers.chatgpt or providers.yahoo) and providers.email %}
        <div class="divider"><span>or</span></div>
      {% endif %}

      {% if providers.email %}
      <form action="{{ url_for('auth.email_start') }}" method="post" class="email-form">
        <label class="field-label" for="email">Email address</label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required autofocus>
        <button type="submit" class="primary">Email me a code</button>
        <p class="fine">We'll send a 6-digit code. No password needed.</p>
      </form>
      {% endif %}

      {% if not providers.google and not providers.github and not providers.gitlab and not providers.microsoft and not providers.discord and not providers.chatgpt and not providers.yahoo and not providers.email %}
        <p class="fine">No sign-in method is configured yet. Add the keys in Render.</p>
      {% endif %}

    </div>

    <p class="hint"><a href="/">← Back to search</a></p>
  </div>
</main>
<footer class="sitefoot">
  <a href="/terms">Terms</a>
  <a href="/privacy">Privacy</a>
</footer>
</body>
</html>
